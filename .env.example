# Copy this file to .env and fill in your key. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: change the port (default 3000)
# PORT=3000

# Optional: a household passcode, if you put the garden on the internet
# APP_PASSCODE=pomegranate

# Optional: a PIN needed to add or delete family voice recordings
# FAMILY_PIN=1234

# Optional: model routing (these are the defaults)
# DESIGN_MODEL=claude-opus-5-5
# DESIGN_EFFORT=xhigh
# TALK_MODEL=claude-opus-5-5
# TALK_EFFORT=medium
