{
  "name": "golestan-persian-tutor",
  "version": "1.0.0",
  "private": true,
  "description": "Golestan — a calm, warm Persian (Farsi) tutor with Shirin, powered by Claude Opus 5.5",
  "type": "module",
  "main": "server/server.ts",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/server.ts",
    "dev": "node --env-file-if-exists=.env --watch server/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "build:sdk": "esbuild scripts/sdk-entry.mjs --bundle --format=esm --platform=browser --target=es2020,safari15 --minify --legal-comments=eof --outfile=docs/vendor/anthropic-sdk.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  }
}
